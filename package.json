{
  "name": "whitewater-client",
  "version": "0.1.0",
  "description": "Whitewater SDK for Node.js/TypeScript: Admin (WCL), Writer, Reader, and Subscription member clients over the whitewater-protocol wire contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/wire.test.ts test/errors.test.ts",
    "test:conformance": "vitest run test/conformance.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
